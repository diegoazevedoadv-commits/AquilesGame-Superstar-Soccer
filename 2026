<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Aquiles Superstar Soccer 2026</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; touch-action: manipulation; }
        body {
            background-color: #0b1d0b;
            font-family: 'Courier New', Courier, monospace;
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
            padding: 10px;
        }
        #game-container {
            width: 100%;
            max-width: 380px;
            background: #153117;
            border: 4px solid #f1c40f;
            border-radius: 10px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.9);
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        .screen {
            width: 100%;
            height: 100%;
            min-height: 480px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: 0;
            left: 0;
            background: linear-gradient(135deg, #0d1f0e 0%, #1e4d22 100%);
            z-index: 10;
            padding: 15px;
            text-align: center;
            overflow-y: auto;
        }
        .screen.hidden { display: none; }
        h1 {
            font-size: 20px;
            color: #f1c40f;
            text-shadow: 2px 2px #c0392b;
            margin-bottom: 8px;
            line-height: 1.2;
        }
        p {
            font-size: 11px;
            margin-bottom: 12px;
            color: #ecf0f1;
            line-height: 1.3;
        }
        .btn {
            background-color: #27ae60;
            color: white;
            border: 3px solid #2ecc71;
            padding: 9px 18px;
            font-size: 13px;
            font-weight: bold;
            font-family: 'Courier New', Courier, monospace;
            border-radius: 6px;
            cursor: pointer;
            text-transform: uppercase;
            box-shadow: 0 4px 0 #145a32;
            transition: all 0.1s ease;
            margin: 4px 0;
            width: 100%;
            max-width: 240px;
        }
        .btn:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #145a32;
        }
        .whatsapp-btn {
            background-color: #25d366;
            border-color: #2ecc71;
            box-shadow: 0 4px 0 #128c7e;
        }
        #player-name {
            width: 100%;
            max-width: 240px;
            padding: 8px;
            font-size: 12px;
            font-family: 'Courier New', Courier, monospace;
            text-align: center;
            border: 2px solid #f1c40f;
            border-radius: 6px;
            background: #111;
            color: #fff;
            margin-bottom: 8px;
            outline: none;
        }
        .results-box {
            width: 100%;
            max-width: 240px;
            background: rgba(0, 0, 0, 0.6);
            border: 2px solid #f1c40f;
            border-radius: 6px;
            padding: 8px;
            margin-bottom: 10px;
        }
        .results-box h3 {
            font-size: 11px;
            color: #f1c40f;
            margin-bottom: 4px;
            text-transform: uppercase;
        }
        .result-row {
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            padding: 3px 0;
            border-bottom: 1px dashed rgba(255,255,255,0.2);
        }
        .result-row:last-child { border-bottom: none; }

        #game-header {
            width: 100%;
            background: #0d1a0e;
            padding: 8px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 3px solid #f1c40f;
            font-size: 11px;
            font-weight: bold;
        }
        canvas {
            background: radial-gradient(circle, #2ecc71 0%, #229954 100%);
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 1 / 1;
            cursor: crosshair;
        }
        #instructions {
            width: 100%;
            background: #0d1a0e;
            padding: 6px;
            text-align: center;
            font-size: 10px;
            color: #f1c40f;
            border-top: 2px solid #f1c40f;
        }
        #message-banner {
            position: absolute;
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0,0,0,0.92);
            border: 3px solid #f1c40f;
            padding: 12px 20px;
            font-size: 16px;
            font-weight: bold;
            color: #f1c40f;
            text-shadow: 2px 2px #c0392b;
            z-index: 5;
            display: none;
            text-align: center;
            border-radius: 6px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.8);
        }
    </style>
</head>
<body>

    <div id="game-container">
        <!-- MENU SCREEN -->
        <div id="menu-screen" class="screen">
            <h1>AQUILES<br>SUPERSTAR SOCCER 2026</h1>
            <p>Leve a Seleção de Aquiles rumo à taça mundial no Mata-Mata!</p>
            <button class="btn" onclick="startWorldCup()" style="margin-top: 15px;">INICIAR PARTIDA</button>
        </div>

        <!-- STAGE ANNOUNCE SCREEN -->
        <div id="stage-screen" class="screen hidden">
            <h1 id="stage-title">QUARTAS DE FINAL</h1>
            <p id="stage-subtitle">Brasil 🇧🇷 vs Argentina 🇦🇷</p>
            <p style="font-size: 10px; color: #f1c40f;">Embate decisivo com cobranças alternadas se houver empate!</p>
            <button class="btn" onclick="startMatch()">ENTRAR EM CAMPO</button>
        </div>

        <!-- RESULTS SCREEN -->
        <div id="results-screen" class="screen hidden">
            <h1>Resultados</h1>
            <p style="font-size: 10px; color: #f1c40f;">Resultados dos outros jogos da rodada:</p>
            
            <div class="results-box">
                <h3>📺 Giro da Copa</h3>
                <div id="other-matches-list"></div>
            </div>

            <button class="btn" onclick="proceedToNextStage()">Jogar próxima fase</button>
        </div>

        <!-- GAME SCREEN HEADER -->
        <div id="game-header">
            <div id="match-score">BRA 0 x 0 ARG</div>
            <div id="score-turn">Sua Vez de Bater</div>
        </div>

        <!-- CANVAS -->
        <canvas id="fieldCanvas" width="420" height="420"></canvas>

        <!-- INSTRUÇÃO -->
        <div id="instructions">Toque no gol para chutar!</div>

        <!-- MESSAGE OVERLAY -->
        <div id="message-banner">GOL!</div>

        <!-- END SCREEN -->
        <div id="end-screen" class="screen hidden">
            <h1 id="end-title">FIM DE JOGO</h1>
            <p id="end-message" style="margin-bottom: 8px;">Você conseguiu!</p>
            
            <input type="text" id="player-name" placeholder="Digite seu Apelido" maxlength="20">
            <button class="btn whatsapp-btn" onclick="shareOnWhatsApp()">📤 Compartilhar no Zap</button>
            <button class="btn" onclick="returnToMenu()">MENU PRINCIPAL</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('fieldCanvas');
        const ctx = canvas.getContext('2d');

        const teams = [
            { 
                name: "Argentina", flag: "🇦🇷", shirt: "#73c2fb", secondary: "#ffffff", 
                gk: { name: "E. Martínez", number: "23", skin: "#f5d0b1", hair: "#3d2314" },
                players: [
                    { name: "Messi", number: "10", skin: "#f5d0b1", hair: "#8b4513" },
                    { name: "Lautaro M.", number: "22", skin: "#f5d0b1", hair: "#2c2c2c" },
                    { name: "Julián A.", number: "9", skin: "#f5d0b1", hair: "#3d2314" },
                    { name: "Enzo F.", number: "24", skin: "#e0ac69", hair: "#2c2c2c" },
                    { name: "Mac Allister", number: "20", skin: "#f5d0b1", hair: "#d4af37" }
                ] 
            },
            { 
                name: "França", flag: "🇫🇷", shirt: "#002366", secondary: "#ffffff", 
                gk: { name: "Maignan", number: "16", skin: "#8d5524", hair: "#2c2c2c" },
                players: [
                    { name: "Mbappé", number: "10", skin: "#8d5524", hair: "#2c2c2c" },
                    { name: "Griezmann", number: "7", skin: "#f5d0b1", hair: "#d4af37" },
                    { name: "Dembélé", number: "11", skin: "#8d5524", hair: "#2c2c2c" },
                    { name: "Tchouaméni", number: "8", skin: "#8d5524", hair: "#2c2c2c" },
                    { name: "Saliba", number: "17", skin: "#8d5524", hair: "#2c2c2c" }
                ] 
            },
            { 
                name: "Portugal", flag: "🇵🇹", shirt: "#ff0000", secondary: "#006600", 
                gk: { name: "D. Costa", number: "22", skin: "#f5d0b1", hair: "#2c2c2c" },
                players: [
                    { name: "CR7", number: "7", skin: "#e0ac69", hair: "#2c2c2c" },
                    { name: "B. Fernandes", number: "8", skin: "#f5d0b1", hair: "#2c2c2c" },
