        function drawOpponentKeeper(x, y) { 
            ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(x, y + 14, 16, 6, 0, 0, Math.PI * 2); ctx.fill(); 
            ctx.fillStyle = currentOpponent.shirt; ctx.fillRect(x - 14, y - 18, 28, 30); 
            ctx.fillStyle = currentOpponent.secondary || '#ffffff'; ctx.font = 'bold 11px Courier New'; ctx.textAlign = 'center'; ctx.fillText(currentOpponent.gk.number, x, y - 1);
            ctx.fillStyle = '#ffffff'; ctx.font = 'bold 7px Courier New'; ctx.fillText(currentOpponent.gk.name, x, y - 20); 
            ctx.fillStyle = currentOpponent.gk.skin; ctx.beginPath(); ctx.arc(x, y - 28, 8, 0, Math.PI * 2); ctx.fill(); 
            ctx.fillStyle = currentOpponent.gk.hair; ctx.beginPath(); ctx.arc(x, y - 31, 7.5, Math.PI, Math.PI * 2); ctx.fill();
        }

        function drawAquilesKeeper(x, y) { 
            ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(x, y + 14, 16, 6, 0, 0, Math.PI * 2); ctx.fill(); 
            ctx.fillStyle = '#f1c40f'; ctx.fillRect(x - 14, y - 18, 28, 30); 
            ctx.fillStyle = '#000000'; ctx.font = 'bold 11px Courier New'; ctx.textAlign = 'center'; ctx.fillText("1", x, y - 1);
            ctx.fillStyle = '#ffffff'; ctx.font = 'bold 7px Courier New'; ctx.fillText("AQUILES", x, y - 20); 
            ctx.fillStyle = '#f5d0b1'; ctx.beginPath(); ctx.arc(x, y - 28, 8, 0, Math.PI * 2); ctx.fill(); 
            ctx.fillStyle = '#b83a14'; ctx.beginPath(); ctx.arc(x, y - 31, 7.5, Math.PI, Math.PI * 2); ctx.fill();
        }

        function drawAquiles(x, y, kicking) { 
            ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(x, y + 16, 15, 6, 0, 0, Math.PI * 2); ctx.fill(); 
            ctx.fillStyle = '#f1c40f'; ctx.fillRect(x - 13, y - 22, 26, 28); 
            ctx.fillStyle = '#000000'; ctx.font = 'bold 11px Courier New'; ctx.textAlign = 'center'; ctx.fillText("10", x, y - 5);
            ctx.fillStyle = '#000000'; ctx.font = 'bold 7px Courier New'; ctx.fillText('AQUILES', x, y - 13); 
            ctx.fillStyle = '#f5d0b1'; ctx.beginPath(); ctx.arc(x, y - 30, 8, 0, Math.PI * 2); ctx.fill(); 
            ctx.fillStyle = '#b83a14'; ctx.beginPath(); ctx.arc(x, y - 33, 7.5, Math.PI, Math.PI * 2); ctx.fill();
        }

        function drawOpponentStriker(x, y) { 
            ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(x, y + 16, 14, 6, 0, 0, Math.PI * 2); ctx.fill(); 
            ctx.fillStyle = currentOpponent.shirt; ctx.fillRect(x - 12, y - 22, 24, 28); 
            ctx.fillStyle = currentOpponent.secondary || '#ffffff'; ctx.font = 'bold 11px Courier New'; ctx.textAlign = 'center'; ctx.fillText(currentOpponent.player.number, x, y - 5);
            ctx.fillStyle = currentOpponent.player.skin; ctx.beginPath(); ctx.arc(x, y - 30, 8, 0, Math.PI * 2); ctx.fill(); 
            ctx.fillStyle = currentOpponent.player.hair; ctx.beginPath(); ctx.arc(x, y - 33, 7.5, Math.PI, Math.PI * 2); ctx.fill();
            ctx.fillStyle = '#fff'; ctx.font = 'bold 7px Courier New'; ctx.fillText(currentOpponent.player.name, x, y - 14); 
