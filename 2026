            isChampionCelebration = false;
            endScreen.classList.add('hidden'); 
            menuScreen.classList.remove('hidden'); 
        }
        
        // --- DESENHO NO CANVAS ---
        function drawField() { 
            ctx.fillStyle = '#1e7b3e'; ctx.fillRect(0, 0, canvas.width, canvas.height); 
            ctx.fillStyle = '#27ae60'; for (let i = 0; i < canvas.height; i += 48) if ((i / 48) % 2 === 0) ctx.fillRect(0, i, canvas.width, 24); 
            ctx.strokeStyle = '#dcdde1'; ctx.lineWidth = 3; ctx.strokeRect(goalBox.x, goalBox.y, goalBox.width, goalBox.height); 
            ctx.strokeRect(goalBox.x + 100, goalBox.y, 80, 40); ctx.beginPath(); ctx.arc(210, goalBox.y + goalBox.height, 40, 0, Math.PI); ctx.stroke(); 
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.22)p'; ctx.lineWidth = 1; 
            for (let x = goalBox.x + 20; x < goalBox.x + goalBox.width; x += 20) { ctx.beginPath(); ctx.moveTo(x, goalBox.y); ctx.lineTo(x, goalBox.y + goalBox.height); ctx.stroke(); } 
            for (let y = goalBox.y + 20; y < goalBox.y + goalBox.height; y += 20) { ctx.beginPath(); ctx.moveTo(goalBox.x, y); ctx.lineTo(goalBox.x + goalBox.width, y); ctx.stroke(); } 
            
            turn === 'player_shoot' ? drawOpponentKeeper(keeperX, keeperY) : drawAquilesKeeper(brazilKeeperX, keeperY); 
            turn === 'player_shoot' ? drawAquiles(210, 390, isKicking) : drawOpponentStriker(210, 390); 
            drawBall(ballPos.x, ballPos.y); 
