                gk: { name: "Unai Simón", number: "23", skin: "#f5d0b1", hair: "#8b4513" },
                players: [
                    { name: "Rodri", number: "16", skin: "#f5d0b1", hair: "#2c2c2c" },
                    { name: "Cucurella", number: "24", skin: "#f5d0b1", hair: "#8b4513" },
                    { name: "Oyarzabal", number: "21", skin: "#f5d0b1", hair: "#8b4513" },
                    { name: "Lamine Y.", number: "19", skin: "#e0ac69", hair: "#2c2c2c" },
                    { name: "N. Williams", number: "11", skin: "#8d5524", hair: "#2c2c2c" }
                ] 
            },
            { 
                name: "Inglaterra", flag: "🏴󠁧󠁢󠁥󠁮󠁧󠁿", shirt: "#ffffff", secondary: "#ce1126", 
                gk: { name: "Pickford", number: "1", skin: "#f5d0b1", hair: "#d4af37" },
                players: [
                    { name: "Kane", number: "9", skin: "#f5d0b1", hair: "#d4af37" },
                    { name: "Bellingham", number: "10", skin: "#e0ac69", hair: "#2c2c2c" },
                    { name: "Saka", number: "7", skin: "#8d5524", hair: "#2c2c2c" },
                    { name: "Foden", number: "11", skin: "#f5d0b1", hair: "#d4af37" },
                    { name: "Rice", number: "4", skin: "#f5d0b1", hair: "#8b4513" }
                ] 
            },
            { 
                name: "Alemanha", flag: "🇩🇪", shirt: "#ffffff", secondary: "#000000", 
                gk: { name: "Neuer", number: "1", skin: "#f5d0b1", hair: "#d4af37" },
                players: [
                    { name: "Musiala", number: "10", skin: "#e0ac69", hair: "#2c2c2c" },
                    { name: "Wirtz", number: "17", skin: "#f5d0b1", hair: "#d4af37" },
                    { name: "Havertz", number: "7", skin: "#f5d0b1", hair: "#d4af37" },
                    { name: "Sané", number: "19", skin: "#e0ac69", hair: "#2c2c2c" },
                    { name: "Rüdiger", number: "2", skin: "#8d5524", hair: "#2c2c2c" }
                ] 
            },
            { 
                name: "Itália", flag: "🇮🇹", shirt: "#0066cc", secondary: "#ffffff", 
                gk: { name: "Buffon", number: "1", skin: "#f5d0b1", hair: "#8b4513" },
                players: [
                    { name: "Baggio", number: "10", skin: "#f5d0b1", hair: "#2c2c2c" },
                    { name: "Totti", number: "10", skin: "#f5d0b1", hair: "#d4af37" },
                    { name: "Pirlo", number: "21", skin: "#f5d0b1", hair: "#8b4513" },
                    { name: "Tonali", number: "8", skin: "#f5d0b1", hair: "#d4af37" },
                    { name: "Maldini", number: "3", skin: "#f5d0b1", hair: "#8b4513" }
                ] 
            }
        ];

        // --- SISTEMA DE ÁUDIO ---
        let audioCtx = null;
        let menuMusicInterval = null;
        let chantInterval = null;
        let isMenuMusicPlaying = false;
        
        function startMenuMusic() { if (isMenuMusicPlaying) return; try { if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); isMenuMusicPlaying = true; const melody = [330, 330, 392, 330, 261, 293, 330, 392, 440, 392, 330, 293, 261, 293, 330, 261]; let idx = 0; menuMusicInterval = setInterval(() => { if (!isMenuMusicPlaying || !audioCtx) return; let osc = audioCtx.createOscillator(); let gain = audioCtx.createGain(); osc.type = 'square'; osc.frequency.setValueAtTime(melody[idx], audioCtx.currentTime); gain.gain.setValueAtTime(0.04, audioCtx.currentTime); gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.14); osc.connect(gain); gain.connect(audioCtx.destination); osc.start(); osc.stop(audioCtx.currentTime + 0.16); idx = (idx + 1) % melody.length; }, 140); } catch (e) {} }
        function stopMenuMusic() { isMenuMusicPlaying = false; if (menuMusicInterval) clearInterval(menuMusicInterval); if (chantInterval) clearInterval(chantInterval); }
        function playCrowdCheer() { if (!audioCtx) return; try { let bSize = audioCtx.sampleRate * 1.5; let b = audioCtx.createBuffer(1, bSize, audioCtx.sampleRate); let out = b.getChannelData(0); for (let i = 0; i < bSize; i++) out[i] = Math.random() * 2 - 1; let noise = audioCtx.createBufferSource(); noise.buffer = b; let filter = audioCtx.createBiquadFilter(); filter.type = 'bandpass'; filter.frequency.value = 900; let gain = audioCtx.createGain(); gain.gain.setValueAtTime(0.01, audioCtx.currentTime); gain.gain.linearRampToValueAtTime(0.18, audioCtx.currentTime + 0.3); gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 1.5); noise.connect(filter); filter.connect(gain); gain.connect(audioCtx.destination); noise.start(); } catch(e) {} }
        function playBrasilChant() { if (!audioCtx) return; try { const notes = [{f:392,d:0.25}, {f:523,d:0.35}, {f:440,d:0.12}, {f:440,d:0.12}, {f:440,d:0.12}, {f:392,d:0.12}, {f:392,d:0.12}, {f:392,d:0.25}, {f:523,d:0.45}]; let t = audioCtx.currentTime; notes.forEach(n => { let osc = audioCtx.createOscillator(); let g = audioCtx.createGain(); osc.type = 'sawtooth'; osc.frequency.setValueAtTime(n.f, t); g.gain.setValueAtTime(0.07, t); g.gain.exponentialRampToValueAtTime(0.001, t + n.d); osc.connect(g); g.connect(audioCtx.destination); osc.start(t); osc.stop(t + n.d); t += n.d + 0.04; }); } catch(e) {} }
        function startChampionChantLoop() { if (chantInterval) clearInterval(chantInterval); playBrasilChant(); chantInterval = setInterval(() => { if (!isChampionCelebration) { clearInterval(chantInterval); return; } playBrasilChant(); }, 3200); }

        // --- VARIÁVEIS DE JOGO ---
        let currentStageIndex = 0; let currentOpponent = null; let poolTeams = []; let brazilGoals = 0; let opponentGoals = 0; let currentKick = 1; let turn = 'player_shoot';
        let isAnimating = false; let gameActive = false; let isChampionCelebration = false;
        let animFrameId = null; // Evita loop duplo

        const scoreDisplay = document.getElementById('match-score');
        const turnDisplay = document.getElementById('score-turn');
        const menuScreen = document.getElementById('menu-screen');
        const stageScreen = document.getElementById('stage-screen');
        const resultsScreen = document.getElementById('results-screen');
        const endScreen = document.getElementById('end-screen');
        const messageBanner = document.getElementById('message-banner');

        const goalBox = { x: 70, y: 55, width: 280, height: 140 }; 
        const keeperY = 85; // Alinhado perfeitamente com a altura onde a bola chega na linha do gol
        let keeperX = 210; let keeperDir = 1; let brazilKeeperX = 210;
        let ballPos = { x: 210, y: 350 }; let aquilesPos = { x: 210, y: 390 }; let isKicking = false;
        let ballStart = { x: 210, y: 350 }; let ballTarget = { x: 210, y: 70 }; let ballAnimProgress = 0;

        function startWorldCup() { currentStageIndex = 0; isChampionCelebration = false; poolTeams = [...teams]; pickNewOpponent(); showStageScreen(); }
        
        function pickNewOpponent() { 
            let available = poolTeams.filter(t => t.name !== currentOpponent?.name); 
            let team = available[Math.floor(Math.random() * available.length)]; 
            currentOpponent = { 
                name: team.name, 
                flag: team.flag, 
                shirt: team.shirt, 
                secondary: team.secondary, 
                squad: team.players, 
                player: team.players[0], 
                gk: team.gk 
            }; 
        }

        function showStageScreen() { stopMenuMusic(); startMenuMusic(); menuScreen.classList.add('hidden'); endScreen.classList.add('hidden'); resultsScreen.classList.add('hidden'); stageScreen.classList.remove('hidden'); document.getElementById('stage-title').innerText = currentStageIndex === 0 ? "QUARTAS DE FINAL" : (currentStageIndex === 1 ? "SEMIFINAL" : "GRANDE FINAL"); document.getElementById('stage-subtitle').innerText = `Brasil 🇧🇷 (Aquiles FC) vs ${currentOpponent.name} ${currentOpponent.flag} (${currentOpponent.player.name})`; }
        
        function startMatch() { 
            stopMenuMusic(); 
            if (animFrameId) cancelAnimationFrame(animFrameId);
            stageScreen.classList.add('hidden'); 
            brazilGoals = 0; opponentGoals = 0; currentKick = 1; turn = 'player_shoot'; gameActive = true; updateMatchHeader(); keeperX = 210; brazilKeeperX = 210; ballPos = { x: 210, y: 350 }; 
            animFrameId = requestAnimationFrame(gameLoop); 
        }

        function updateMatchHeader() { scoreDisplay.innerText = `BRA ${brazilGoals} x ${opponentGoals} ${currentOpponent.name.toUpperCase().slice(0,3)}`; turnDisplay.innerText = currentKick <= 5 ? (turn === 'player_shoot' ? `Aquiles!` : `Defesa!`) : `Morte Súbita`; }

        function gameLoop() {
            if (!gameActive) return;
            if (menuScreen.classList.contains('hidden') && stageScreen.classList.contains('hidden') && resultsScreen.classList.contains('hidden') && endScreen.classList.contains('hidden')) {
                if (isChampionCelebration) { 
                    drawChampionScene(); 
                } else {
                    let kX = (turn === 'player_shoot') ? keeperX : brazilKeeperX;
                    kX += keeperDir * (3.2 + (Math.min(currentKick, 5) * 1.4));
                    if (kX > goalBox.x + goalBox.width - 35 || kX < goalBox.x + 35) keeperDir *= -1;
                    if (turn === 'player_shoot') keeperX = kX; else brazilKeeperX = kX;
                    
                    if (isAnimating) { 
                        ballAnimProgress += 0.18; 
                        ballPos.x = ballStart.x + (ballTarget.x - ballStart.x) * ballAnimProgress; 
                        ballPos.y = ballStart.y + (ballTarget.y - ballStart.y) * ballAnimProgress; 
                        if (ballPos.y <= goalBox.y + 25) { 
                            isAnimating = false; 
                            turn === 'player_shoot' ? evaluatePlayerShot(ballPos.x, keeperX) : evaluateAiShot(ballPos.x, brazilKeeperX); 
                        } 
                    }
                    drawField();
                }
            }
            animFrameId = requestAnimationFrame(gameLoop);
        }

        // --- LÓGICA DE JOGO ---
        function evaluatePlayerShot(ballX, currentKeeperX) {
            let isGoal = Math.abs(ballX - currentKeeperX) > 48;
            if (isGoal) { brazilGoals++; playCrowdCheer(); showBanner(`GOL DO AQUILES! ⚽`, "#f1c40f"); } 
            else { showBanner(`Defesa de ${currentOpponent.gk.name}! 🧤`, "#e74c3c"); }
            updateMatchHeader();
            setTimeout(() => { messageBanner.style.display = 'none'; ballPos = { x: 210, y: 350 }; ballAnimProgress = 0; turn = 'ai_shoot'; updateMatchHeader(); setTimeout(executeAiShotSequence, 1000); }, 1200);
        }

        function evaluateAiShot(ballX, currentBrazilKeeperX) {
            if (Math.abs(ballX - currentBrazilKeeperX) < 48) { playCrowdCheer(); showBanner(`Defesa do Aquiles! 🇧🇷🧤`, "#f1c40f"); } 
            else { opponentGoals++; showBanner(`GOL DE ${currentOpponent.player.name.toUpperCase()}! ⚽`, "#e74c3c"); }
            updateMatchHeader();
            setTimeout(() => {
                messageBanner.style.display = 'none'; ballPos = { x: 210, y: 350 }; ballAnimProgress = 0;
                if (currentKick <= 5) { if (Math.abs(brazilGoals - opponentGoals) > (5 - currentKick)) checkMatchOver(); else if (currentKick === 5 && brazilGoals === opponentGoals) { currentKick++; turn = 'player_shoot'; showBanner("EMPATE! ALTERNADAS!", "#f1c40f"); updateMatchHeader(); } else { currentKick++; turn = 'player_shoot'; updateMatchHeader(); } }
                else { if (brazilGoals !== opponentGoals) checkMatchOver(); else { currentKick++; turn = 'player_shoot'; showBanner("PRÓXIMA RODADA!", "#f1c40f"); updateMatchHeader(); } }
            }, 1400);
        }

        function executeAiShotSequence() { 
            if (!gameActive) return; 
            currentOpponent.player = currentOpponent.squad[Math.floor(Math.random() * currentOpponent.squad.length)];
            ballStart = { x: 210, y: 350 }; 
            ballTarget = { x: goalBox.x + 30 + Math.random() * (goalBox.width - 60), y: goalBox.y + 20 + Math.random() * 50 }; 
            ballAnimProgress = 0; 
            isAnimating = true; 
        }

        function checkMatchOver() { 
            gameActive = false; 
            if (brazilGoals > opponentGoals) { 
                if (currentStageIndex === 2) { 
                    isChampionCelebration = true; 
                    gameActive = true; 
                    startChampionChantLoop(); 
                } else {
                    showResultsScreen(); 
                }
            } else {
                showEndScreen(false, false); 
            }
        }

        function showResultsScreen() { startMenuMusic(); let otherTeams = teams.filter(t => t.name !== currentOpponent.name); let shuffled = [...otherTeams].sort(() => 0.5 - Math.random()); let html = `<div class="result-row"><span>Brasil 🇧🇷 ${brazilGoals} x ${opponentGoals} ${currentOpponent.flag} ${currentOpponent.name}</span> <span>(Classificado)</span></div>`; if (shuffled.length >= 2) { html += `<div class="result-row"><span>${shuffled[0].flag} ${shuffled[0].name} ${Math.floor(Math.random()*3)} x ${Math.floor(Math.random()*3)} ${shuffled[1].flag} ${shuffled[1].name}</span></div>`; } document.getElementById('other-matches-list').innerHTML = html; resultsScreen.classList.remove('hidden'); }
        function proceedToNextStage() { resultsScreen.classList.add('hidden'); currentStageIndex++; pickNewOpponent(); showStageScreen(); }
        function showEndScreen(isChampion) { startMenuMusic(); endScreen.classList.remove('hidden'); document.getElementById('end-title').innerText = isChampion ? "BRASIL CAMPEÃO!" : "ELIMINADO"; document.getElementById('end-message').innerText = isChampion ? `Aquiles levantou a Taça!` : `Brasil eliminado por ${currentOpponent.name}.`; }
        function showBanner(text, color) { messageBanner.innerText = text; messageBanner.style.color = color; messageBanner.style.display = 'block'; }
        function shareOnWhatsApp() { let text = `⚽ *AQUILES SUPERSTAR SOCCER 2026* 🇧🇷\nSou craque e levei a Seleção do Aquiles ao título!\nhttps://comfy-sunburst-37e602.netlify.app`; window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank'); }
        function returnToMenu() { 
