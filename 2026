        function drawBall(x, y) { ctx.fillStyle = 'rgba(0,0,0,0.45)'; ctx.beginPath(); ctx.ellipse(x, y + 8, 6, 3, 0, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = '#ffffff'; ctx.beginPath(); ctx.arc(x, y, 7, 0, Math.PI * 2); ctx.fill(); ctx.strokeStyle = '#2c3e50'; ctx.lineWidth = 1.5; ctx.stroke(); }
        
        // --- CENA DE CAMPEÃO COM OS 6 CRAQUES E A TAÇA ---
        function drawChampionScene() { 
            ctx.fillStyle = '#0b1d0b'; ctx.fillRect(0, 0, canvas.width, canvas.height); 
            for (let i = 0; i < 50; i++) { 
                ctx.fillStyle = (i % 2 === 0) ? '#f1c40f' : '#ffffff'; 
                ctx.fillRect((i * 35) % canvas.width, (Date.now() / 8 + i * 18) % canvas.height, 4, 4); 
            } 
            
            ctx.fillStyle = '#f1c40f'; ctx.font = 'bold 14px Courier New'; ctx.textAlign = 'center'; 
            ctx.fillText('🇧🇷 CAMPEÕES DO MUNDO 2026 🏆', canvas.width / 2, 35);

            // Taça da Copa do Mundo no Centro
            let tX = canvas.width / 2;
            let tY = 150;
            ctx.fillStyle = '#f1c40f'; ctx.fillRect(tX - 8, tY - 15, 16, 25);
            ctx.beginPath(); ctx.arc(tX, tY - 15, 10, Math.PI, 0, false); ctx.fill();
            ctx.fillStyle = '#d4af37'; ctx.fillRect(tX - 3, tY + 10, 6, 12); ctx.fillRect(tX - 10, tY + 22, 20, 6);

            // Os 6 Lendários comemorando
            const legends = [
                { name: "AQUILES", x: tX - 120, y: 220, shirt: "#f1c40f", hair: "#b83a14", skin: "#f5d0b1" },
                { name: "ENDRICK", x: tX - 70, y: 250, shirt: "#f1c40f", hair: "#2c2c2c", skin: "#8d5524" },
                { name: "RONALDO", x: tX - 25, y: 270, shirt: "#f1c40f", hair: "none", skin: "#e0ac69" }, // Careca
                { name: "NEYMAR", x: tX + 25, y: 270, shirt: "#f1c40f", hair: "#d4af37", skin: "#e0ac69" },
                { name: "ALISSON", x: tX + 70, y: 250, shirt: "#1abc9c", hair: "#8b4513", skin: "#f5d0b1" },
                { name: "SÓCRATES", x: tX + 120, y: 220, shirt: "#f1c40f", hair: "#2c2c2c", skin: "#f5d0b1" }
            ];

            legends.forEach(l => {
                ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(l.x, l.y + 16, 12, 5, 0, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = l.shirt; ctx.fillRect(l.x - 10, l.y - 12, 20, 24);
                ctx.strokeStyle = '#000'; ctx.lineWidth = 1; ctx.strokeRect(l.x - 10, l.y - 12, 20, 24);

                ctx.fillStyle = '#ffffff'; ctx.font = 'bold 7px Courier New'; ctx.textAlign = 'center'; 
                ctx.fillText(l.name, l.x, l.y - 16);

                ctx.fillStyle = l.skin; ctx.beginPath(); ctx.arc(l.x, l.y - 21, 6, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

                if (l.hair !== "none") {
                    ctx.fillStyle = l.hair;
                    ctx.beginPath(); ctx.arc(l.x, l.y - 23, 5.5, Math.PI, Math.PI * 2); ctx.fill();
                }
            });

            ctx.fillStyle = '#ffffff'; ctx.font = '10px Courier New';
            ctx.fillText('Toque em MENU PRINCIPAL para jogar novamente', canvas.width / 2, canvas.height - 20);
        }

        function handleInput(clientX, clientY) { if (isAnimating || isChampionCelebration || turn !== 'player_shoot' || !menuScreen.classList.contains('hidden') || !stageScreen.classList.contains('hidden') || !resultsScreen.classList.contains('hidden') || !endScreen.classList.contains('hidden')) return; const rect = canvas.getBoundingClientRect(); const scaleX = canvas.width / rect.width; const scaleY = canvas.height / rect.height; let destX = Math.max(goalBox.x + 15, Math.min((clientX - rect.left) * scaleX, goalBox.x + goalBox.width - 15)); let destY = Math.max(goalBox.y + 10, Math.min((clientY - rect.top) * scaleY, goalBox.y + goalBox.height - 10)); executePlayerShot(destX, destY); }
        canvas.addEventListener('click', (e) => handleInput(e.clientX, e.clientY)); canvas.addEventListener('touchstart', (e) => handleInput(e.touches[0].clientX, e.touches[0].clientY), { passive: false });
        function executePlayerShot(destX, destY) { isAnimating = true; isKicking = true; ballStart = { x: ballPos.x, y: ballPos.y }; ballTarget = { x: destX, y: destY }; ballAnimProgress = 0; setTimeout(() => { isKicking = false; }, 200); }
        drawField();
